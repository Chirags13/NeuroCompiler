{
  "version": "2.0",
  "primary_objective": "execution_runtime",
  "row_granularity": "one_transition_after_one_candidate_pass",
  "required_fields": [
    "record_id",
    "program_id",
    "project_id",
    "benchmark_family",
    "split",
    "source_hash",
    "input_id",
    "input_hash",
    "target_arch",
    "llvm_version",
    "compiler_id",
    "optimization_origin",
    "pass_sequence",
    "candidate_pass",
    "step_index",
    "correctness",
    "runtime_before_ns",
    "runtime_after_ns",
    "runtime_speedup",
    "runtime_delta_log",
    "compile_time_ns",
    "binary_text_size_before",
    "binary_text_size_after",
    "ir_instruction_count_before",
    "ir_instruction_count_after",
    "feature_vector",
    "hardware"
  ],
  "optional_fields": [
    "perf_cycles",
    "perf_instructions",
    "perf_branches",
    "perf_branch_misses",
    "perf_cache_references",
    "perf_cache_misses",
    "peak_rss_bytes",
    "energy_uj",
    "ir_before_path",
    "ir_after_path",
    "stdout_sha256",
    "stderr_sha256",
    "failure_reason"
  ],
  "notes": {
    "runtime_speedup": "runtime_before / runtime_after; values > 1 are better",
    "runtime_delta_log": "log(runtime_before / runtime_after); positive is better",
    "correctness": "must be true for a record to be eligible for model training",
    "feature_vector": "JSON object of deterministic static LLVM IR features",
    "hardware": "CPU/OS/compiler identity captured for every run"
  }
}
